{
  "_comment": "Copy to local-rules.json and pass with --rules ./local-rules.json. Keep that file out of version control.",
  "rules": [
    {
      "name": "example-internal-token",
      "severity": "high",
      "pattern": "corp_[A-Za-z0-9]{32}",
      "replace": "INTERNAL_API_TOKEN_EXAMPLE"
    },
    {
      "name": "example-ssh-key-inline",
      "severity": "high",
      "pattern": "ssh-rsa\\s+[A-Za-z0-9+/=]{100,}",
      "replace": "SSH_PUBLIC_KEY_EXAMPLE",
      "flags": ""
    },
    {
      "name": "example-private-note",
      "severity": "medium",
      "pattern": "(?i)dont[_-]?commit[_-]?key\\s*[:=]\\s*['\"]([^'\"]{8,})['\"]",
      "replace": "SOMETHING_YOU_SHOULD_NOT_COMMIT"
    }
  ]
}
